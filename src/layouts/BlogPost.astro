---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Bracket from '../components/Bracket.astro';
import FormattedDate from '../components/FormattedDate.astro';
import HeroArt from '../components/HeroArt.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, subtitle, description, pubDate, updatedDate, heroImage, heroArt, tags = [], category } =
	Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article>
		<div class="title">
			<div class="date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<div class="last-updated-on">
							Last updated on <FormattedDate date={updatedDate} />
						</div>
					)
				}
			</div>
			<h1 class="holo-text">{title}</h1>
			{subtitle && <p class="subtitle">{subtitle}</p>}
			{
				(category || tags.length > 0) && (
					<div class="tags">
						{category && <Bracket href={`/blog/#${encodeURIComponent(category)}`}>{category}</Bracket>}
						{tags.map((tag) => (
							<Bracket variant="plain">{tag}</Bracket>
						))}
					</div>
				)
			}
		</div>
		{
			heroArt ? (
				<HeroArt class="hero-image" gray={heroArt.gray} holo={heroArt.holo} />
			) : (
				heroImage && <Image class="hero-image" width={1020} height={510} src={heroImage} alt="" />
			)
		}
		<div class="prose">
			<slot />
		</div>
	</article>
</BaseLayout>
<style>
	.title {
		margin-bottom: 2.5rem;
	}
	.date {
		margin-bottom: 0.75rem;
		color: var(--text-faint);
		font-size: 0.9rem;
	}
	.subtitle {
		color: var(--text-muted);
		font-size: 1.2rem;
		margin: 0.25rem 0 0;
	}
	.last-updated-on {
		font-style: italic;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	article :global(.hero-image) {
		width: 100%;
		margin-bottom: 2.5rem;
	}
	.prose {
		max-width: 680px;
		margin: 0 auto;
		font-size: 1.1rem;
		line-height: 1.75;
	}
	.prose :global(p) {
		margin-bottom: 1.5em;
	}
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 2.25rem;
	}
</style>
