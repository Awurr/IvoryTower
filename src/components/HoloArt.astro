---
// Two-layer pixel art inside a post: <HoloArt gray="…" holo="…" scale="3" caption="…" />.
// Paths are the art files as Keystatic's pickers save them, e.g.
// 'src/assets/art/Tower.Gray.png'. Renders with HeroArt (shared shimmer,
// whole-number scaling up to `scale`).
import type { ImageMetadata } from 'astro';
import HeroArt from './HeroArt.astro';

interface Props {
	gray: string;
	holo: string;
	/** Largest whole-number scale; 3 matches the 3px border lines */
	scale?: number | string;
	caption?: string;
}

const { gray, holo, scale = 3, caption } = Astro.props;

// MDX passes plain strings, so look the files up to get their size and URL
const artFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/art/**/*.png', {
	eager: true,
});
function resolveArt(path: string) {
	const file = artFiles['/' + path.replace(/^\/+/, '')];
	if (!file) throw new Error(`HoloArt: no art file at "${path}" (it must be in src/assets/art/ or a subfolder)`);
	return file.default;
}
---

<figure>
	<HeroArt gray={resolveArt(gray)} holo={resolveArt(holo)} maxScale={Number(scale)} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	/* Kept below the post's paragraph spacing, so next to text the gap is just
	   the normal space between paragraphs */
	figure {
		margin: 1.25rem 0;
	}
	figcaption {
		margin-top: 0.75rem;
		color: var(--text-faint);
		font-size: 0.9rem;
		text-align: center;
	}
</style>
