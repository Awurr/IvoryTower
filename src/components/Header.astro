---
import homeGray from '../assets/art/HeaderHome.Gray.png';
import homeHolo from '../assets/art/HeaderHome.Holo.png';
import postGray from '../assets/art/HeaderPost.Gray.png';
import postHolo from '../assets/art/HeaderPost.Holo.png';
import writingGray from '../assets/art/HeaderWriting.Gray.png';
import writingHolo from '../assets/art/HeaderWriting.Holo.png';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import HeroArt from './HeroArt.astro';

// Header art depends on the page: home (2x), the /blog/ archive (3x), and
// everything else, i.e. posts and /about/ (3x). At 3x one art pixel matches
// the 3px rule width.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const art =
	path === '/'
		? { gray: homeGray, holo: homeHolo, maxScale: 2 }
		: path === '/blog'
			? { gray: writingGray, holo: writingHolo, maxScale: 3 }
			: { gray: postGray, holo: postHolo, maxScale: 3 };
---

<header class="glow-panel glow-h">
	<a class="logo" href="/">{SITE_TITLE}</a>
	<HeroArt class="header-art" gray={art.gray} holo={art.holo} maxScale={art.maxScale} />
	<nav>
		<HeaderLink href="/">home</HeaderLink>
		<HeaderLink href="/blog">writing</HeaderLink>
		<HeaderLink href="/about">about</HeaderLink>
	</nav>
</header>
<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		/* Tighter than the text-only header so the 40px-tall art keeps it about the same height */
		padding: 0.5rem 1.5rem;
		margin-bottom: 3rem;
	}
	header :global(.header-art) {
		flex: 1;
		min-width: 0;
	}
	.logo {
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 1.5rem;
		font-size: 14px;
	}
	@media (max-width: 720px) {
		header {
			padding: 1rem 1.5rem;
		}
		header :global(.header-art) {
			display: none;
		}
	}
</style>
