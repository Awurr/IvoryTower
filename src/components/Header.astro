---
import headerGray from '../assets/art/Header.Gray.png';
import headerHolo from '../assets/art/Header.Holo.png';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import HeroArt from './HeroArt.astro';
---

<header class="glow-panel glow-h">
	<a class="logo" href="/">{SITE_TITLE}</a>
	<HeroArt class="header-art" gray={headerGray} holo={headerHolo} maxScale={2} />
	<nav>
		<HeaderLink href="/">home</HeaderLink>
		<HeaderLink href="/blog">writing</HeaderLink>
		<HeaderLink href="/about">about</HeaderLink>
	</nav>
</header>
<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		/* Tighter than the text-only header so the 40px-tall art keeps it about the same height */
		padding: 0.5rem 1.5rem;
		margin-bottom: 3rem;
	}
	header :global(.header-art) {
		flex: 1;
		min-width: 0;
	}
	.logo {
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 1.5rem;
		font-size: 14px;
	}
	@media (max-width: 720px) {
		header {
			padding: 1rem 1.5rem;
		}
		header :global(.header-art) {
			display: none;
		}
	}
</style>
