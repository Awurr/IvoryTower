---
import { getCollection } from 'astro:content';
import Bracket from '../components/Bracket.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = posts.slice(0, 6);
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<h1 class="holo-text">ivory tower</h1>
		<p>{SITE_DESCRIPTION}</p>
		<div class="btn-row">
			{posts[0] && (
				<Bracket size="button" href={`/blog/${posts[0].id}/`}>Read the latest</Bracket>
			)}
			<Bracket size="button" href="/blog">All writing</Bracket>
		</div>
	</section>

	<h2 class="section-title holo-text">Recent writing</h2>
	<div class="grid">
		{recent.map((post, i) => <PostCard post={post} isNew={i === 0} />)}
	</div>

	{
		topics.length > 0 && (
			<>
				<h2 class="section-title holo-text">Browse by topic</h2>
				<div class="topics">
					{topics.map((topic) => (
						<Bracket>{topic}</Bracket>
					))}
				</div>
			</>
		)
	}
</BaseLayout>
<style>
	.hero {
		margin-bottom: 4rem;
	}
	.hero h1 {
		margin: 0 0 0.75rem;
	}
	.hero p {
		color: var(--text-muted);
		font-size: 1.05rem;
		max-width: 40ch;
		margin: 0 0 2rem;
	}
	.btn-row {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
		margin: 0 0 4rem;
	}
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 4rem;
	}
</style>
