---
import { Image } from 'astro:assets';
import aboutGray from '../assets/art/About.Gray.png';
import aboutHolo from '../assets/art/About.Holo.png';
import closingLeftGray from '../assets/art/ClosingLeft.Gray.png';
import closingLeftHolo from '../assets/art/ClosingLeft.Holo.png';
import closingRightGray from '../assets/art/ClosingRight.Gray.png';
import closingRightHolo from '../assets/art/ClosingRight.Holo.png';
import recentGray from '../assets/art/Recent.Gray.png';
import recentHolo from '../assets/art/Recent.Holo.png';
import titleGray from '../assets/art/Title.Gray.png';
import titleHolo from '../assets/art/Title.Holo.png';
import Bracket from '../components/Bracket.astro';
import FormattedDate from '../components/FormattedDate.astro';
import HeroArt from '../components/HeroArt.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getListedPosts, postUrl } from '../lib/posts';

const posts = await getListedPosts();
const [latest, ...rest] = posts;
const recent = rest.slice(0, 3);
// Size the latest-post column so its hero art fits at exactly 2x
const latestWidth = latest?.data.heroArt ? `${latest.data.heroArt.gray.width * 2}px` : undefined;
// Keep the About art at the same pixel scale as the latest post's art. On narrow
// screens the latest art fills the full content width (the `.home` container), so:
// below 2 art-widths it drops to 1x -> cap the About art at 1x too; below 1
// art-width it shrinks to fit -> shrink the About art by the same ratio. Inside
// the About box, the content width is the art's container + 48px of padding.
const latestArtW = latest?.data.heroArt?.gray.width;
const aboutMatchCss =
	latestArtW &&
	`@container home (width < ${latestArtW * 2}px) { .about-art .art { --max-scale: 1 !important; } }
	@container home (width < ${latestArtW}px) { .about-art .art { width: calc((100cqw + 48px) * ${aboutGray.width} / ${latestArtW}) !important; } }`;
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="home">
		<section class="hero" style={latestWidth && `--latest-w: ${latestWidth}`}>
			<div class="hero-side">
				<div class="intro">
					<p>{SITE_DESCRIPTION}</p>
					<h1 class="holo-text">ivory tower</h1>
				</div>
				<HeroArt class="deco tower-art" gray={titleGray} holo={titleHolo} maxScale={2} />
			</div>

			{
				latest && (
					<article class="latest glow-panel glow-h">
						<Bracket class="latest-tag">latest</Bracket>
						{latest.data.heroArt ? (
							<a class="latest-art" href={postUrl(latest)} tabindex="-1" aria-hidden="true">
								<HeroArt gray={latest.data.heroArt.gray} holo={latest.data.heroArt.holo} />
							</a>
						) : (
							latest.data.heroImage && (
								<a href={postUrl(latest)} tabindex="-1" aria-hidden="true">
									<Image width={720} height={360} src={latest.data.heroImage} alt="" />
								</a>
							)
						)}
						<FormattedDate date={latest.data.pubDate} />
						<h2>
							<a href={postUrl(latest)}>{latest.data.title}</a>
						</h2>
						<p>{latest.data.description}</p>
						<Bracket size="button" href={postUrl(latest)}>Read the latest</Bracket>
					</article>
				)
			}
		</section>

		{
			recent.length > 0 && (
				<section class="recent">
					<div class="section-head">
						<h2 class="section-title holo-text">Recent writing</h2>
						<HeroArt class="deco recent-art" gray={recentGray} holo={recentHolo} maxScale={2} />
						<Bracket size="button" href="/blog">All writing</Bracket>
					</div>
					<div class="grid">
						{recent.map((post) => <PostCard post={post} />)}
					</div>
				</section>
			)
		}

		<section class="about glow-panel glow-h" style={`--about-art-w: ${aboutGray.width * 2}px`}>
			<div class="about-text">
				<h2 class="holo-text">About this website</h2>
				<p>Hi! I'm <i>Nora (she/they)</i> and this is my blog, <i>Ivory Tower</i>. I made this website to escape social media and to have real discussions about the digital world.</p>
				<Bracket size="button" href="/about">More about my blog</Bracket>
			</div>
			<div class="about-art">
				<HeroArt gray={aboutGray} holo={aboutHolo} maxScale={2} />
			</div>
			{aboutMatchCss && <style is:inline set:html={aboutMatchCss} />}
		</section>

		{
			topics.length > 0 && (
				<>
					<h2 class="section-title holo-text">Browse by topic</h2>
					<div class="topics">
						{topics.map((topic) => (
							<Bracket>{topic}</Bracket>
						))}
					</div>
				</>
			)
		}

		<div class="closing">
			<HeroArt class="deco" gray={closingLeftGray} holo={closingLeftHolo} maxScale={2} />
			<p>From me, to you. &lt;3</p>
			<HeroArt class="deco" gray={closingRightGray} holo={closingRightHolo} maxScale={2} />
		</div>
	</div>
</BaseLayout>
<style>
	/* Measured by the About-art scale matching above */
	.home {
		container: home / inline-size;
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, var(--latest-w, 1.15fr));
		/* Leaves the left column 260px: exactly the 2x tower art (130px wide) */
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}
	/* The tower art fills the column behind the title. It's pinned to the bottom so
	   the tower never moves; when the column (which matches the latest panel's
	   height) is shorter than the art, the faded sky at the top is trimmed. */
	.hero-side {
		position: relative;
		overflow: hidden;
		padding-top: 2.125rem;
	}
	.hero-side :global(.tower-art) {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
	}
	.intro {
		position: relative;
		z-index: 1; /* in front of the tower */
		padding: 0 1.75rem;
	}
	.intro h1 {
		margin: 0;
	}
	.intro p {
		color: var(--text-muted);
		font-size: 1.05rem;
		max-width: 40ch;
		margin: 0 0 0.25rem;
	}
	.latest {
		padding: 1.5rem 0;
	}
	.latest :global(.latest-tag) {
		display: inline-block;
		margin-bottom: 1rem;
	}
	.latest img {
		width: 100%;
		margin-bottom: 1rem;
	}
	.latest-art {
		display: block;
		margin-bottom: 1rem;
	}
	.latest :global(time) {
		color: var(--text-faint);
		font-size: 0.85rem;
	}
	.latest h2 {
		font-size: 1.6rem;
		margin: 0.25rem 0 0.5rem;
	}
	.latest h2 a {
		text-decoration: none;
	}
	.latest h2 a:hover {
		text-decoration: underline;
		text-decoration-color: var(--border-line);
	}
	.latest p {
		color: var(--text-muted);
		margin: 0 0 1.5rem;
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.section-head h2 {
		margin: 0;
	}
	.section-head :global(.recent-art) {
		flex: 1;
		min-width: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
		margin: 0 0 4rem;
	}
	.about {
		position: relative;
		padding: 1.5rem;
		margin-bottom: 4rem;
	}
	/* Art sits behind the text on the right, reaching about halfway across */
	.about-art {
		position: absolute;
		inset-block: 0;
		right: 1.5rem;
		width: var(--about-art-w);
		display: flex;
		align-items: center;
	}
	.about-art :global(.hero-art) {
		flex: 1;
	}
	.about-text {
		position: relative;
		z-index: 1; /* in front of the art */
	}
	.about h2 {
		margin: 0 0 0.75rem;
	}
	.about p {
		color: var(--text-muted);
		max-width: 60ch;
		margin: 0 0 1.5rem;
	}
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 4rem;
	}
	.closing {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 1.5rem;
		align-items: center;
		/* Collapses with the 4rem gaps above (About) and below (footer) to leave 1.5rem each side */
		margin: -2.5rem 0;
	}
	.closing p {
		color: var(--text-muted);
		font-style: italic;
		text-align: center;
		margin: 0;
	}
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
		}
		/* Too narrow to sit behind the text: show it below instead */
		.about-art {
			position: static;
			width: auto;
			margin-top: 1.5rem;
		}
		.closing {
			grid-template-columns: 1fr;
		}
		/* No room for the decorative strips on phones */
		:global(.deco) {
			display: none;
		}
	}
</style>
