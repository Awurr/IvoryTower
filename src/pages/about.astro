---
// Renders the about post from src/content/blog/about.mdx
import { getEntry, render } from 'astro:content';
import { mdxComponents } from '../components/mdx';
import BlogPost from '../layouts/BlogPost.astro';
import { ABOUT_ID } from '../lib/posts';

const post = await getEntry('blog', ABOUT_ID);
if (!post) throw new Error(`Missing src/content/blog/${ABOUT_ID}.mdx`);
const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content components={mdxComponents} />
</BlogPost>
